SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_VUL_HIER_IN
SITE_URL=http://localhost:3000

# Optional, public GTM container ID (e.g. GTM-ABCDEFG). Marketing homepage only.
# Leave empty until the GTM container has been configured for safe, consented pageviews.
NEXT_PUBLIC_GTM_ID=

# Apple Health is a draft shell and stays off. Only the exact value "true" enables it.
# Leave this empty in every deployment. It does not ship a native bridge or write health data.
NEXT_PUBLIC_FEATURE_APPLE_HEALTH=

# Account deletion uses public.delete_own_account() for the signed-in user.
# Do not add a service-role or secret key to this file or to NEXT_PUBLIC_ variables.
